# Flutter build output. The platform folders themselves are committed: both apps
# carry permission declarations and store strings that must not be regenerated.
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/android/local.properties
**/.idea/
*.iml

# The Flutter web builds the panel serves at /apps/driver and /apps/customer.
# Compiled output, rebuilt by `make web-apps` — the sources are mobile/ and
# mobile_customer/, including their web/ shells, which are committed.
panel/public/apps/
