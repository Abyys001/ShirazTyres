<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) blocks cleartext HTTP by default, which is what stopped the
  app reaching the development API on http://10.0.2.2:8000 — every sign-in and
  registration call failed as a connection error before it left the device.

  Release traffic stays HTTPS-only; only the loopback hosts a developer actually
  runs the API on are excused. Testing against a machine on your LAN? Add that
  address here (e.g. <domain>192.168.1.24</domain>) — nothing else needs changing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The host machine as seen from a Waydroid container. -->
        <domain includeSubdomains="false">192.168.240.1</domain>
        <!-- Genymotion's equivalent. -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!-- `adb reverse tcp:8000 tcp:8000` on a physical device. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
