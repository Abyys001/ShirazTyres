# ---------------------------------------------------------------- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# Set USE_SQLITE=1 to run without Postgres/Redis (tests, quick local work).
USE_SQLITE=0
POSTGRES_DB=shiraztyres
POSTGRES_USER=shiraztyres
POSTGRES_PASSWORD=shiraztyres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side port for psql access; 5432 is often taken by a local Postgres.
POSTGRES_HOST_PORT=5433

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PANEL_BASE_URL=http://localhost:3000

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# ------------------------------------------------------------------- OTP ----
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --------------------------------------------------------------- Providers --
# mock | twilio — mock logs the code and returns it as debug_code.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# mock | fcm
PUSH_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# 1 = canned vehicle data, no external calls and no spend.
VEHICLE_LOOKUP_MOCK=1
DVLA_API_KEY=
DVLA_VES_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
TYRE_API_KEY=
TYRE_API_URL=https://uk1.ukvehicledata.co.uk/api/datapackage/TyreData
VEHICLE_LOOKUP_TTL_DAYS=30
EXTERNAL_HTTP_TIMEOUT=10

# ------------------------------------------------- Where call-outs land -----
SHOP_NOTIFY_SMS=+447700900999
SHOP_NOTIFY_EMAIL=owner@shiraztyres.co.uk
DEFAULT_FROM_EMAIL=no-reply@shiraztyres.co.uk
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# ----------------------------------------------------------------- Panel ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Where the panel's server side reaches the API (inside the compose network).
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
