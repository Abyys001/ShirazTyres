# ---------------------------------------------------------------- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.2.2,192.168.240.1
LOG_LEVEL=INFO

# Set USE_SQLITE=1 to run without Postgres/Redis (tests, quick local work).
USE_SQLITE=0
POSTGRES_DB=shiraztyres
POSTGRES_USER=shiraztyres
POSTGRES_PASSWORD=shiraztyres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side port for psql access; 5432 is often taken by a local Postgres.
POSTGRES_HOST_PORT=5433

# The ports the stack publishes on this machine. Change them when something else
# already holds 8000 or 3000 — and change NEXT_PUBLIC_API_BASE_URL,
# NEXT_PUBLIC_WS_BASE_URL, CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS to
# match, because the browser talks to these and the API checks the origin.
BACKEND_HOST_PORT=8000
PANEL_HOST_PORT=3000
WEBSITE_HOST_PORT=3001

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
# WebSocket fan-out (panel map, customer ETA, driver offers). Its own Redis db.
CHANNEL_LAYER_URL=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PANEL_BASE_URL=http://localhost:3000
CUSTOMER_BASE_URL=http://localhost:3001

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=180

# Driver photos and documents. Served by the web server in production.
MEDIA_ROOT=/app/media
MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------- OTP ----
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=10

# --------------------------------------------------------------- Providers --
# mock | twilio — mock logs the code and returns it as debug_code.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# mock | fcm
PUSH_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# ---------------------------------------------- Customer sign-in (4.1) ------
# 1 = accept "mock:someone@example.com" as an ID token. Never enable in production.
GOOGLE_OAUTH_MOCK=1
# Every client id that may sign a token we accept: web, Android app, iOS app.
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# ------------------------------------------------- Vehicle data (9.1/9.2) ---
# 1 = canned vehicle data, no external calls and no spend.
VEHICLE_LOOKUP_MOCK=1
DVLA_API_KEY=
DVLA_VES_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
TYRE_API_KEY=
TYRE_API_URL=https://uk1.ukvehicledata.co.uk/api/datapackage/TyreData
VEHICLE_LOOKUP_TTL_DAYS=30
EXTERNAL_HTTP_TIMEOUT=10

# --------------------------------------------- Routing and maps (10) --------
# mock | osrm | valhalla | graphhopper. Never leave this on mock in production —
# dispatch ranks candidates by travel time and the mock is straight-line arithmetic.
ROUTING_PROVIDER=mock
ROUTING_BASE_URL=http://osrm:5000
ROUTING_API_KEY=
ROUTING_TIMEOUT=8

# Section 10.2: a default routing profile is optimistic in London. Calibrate these
# against real journey times before launch.
TRAFFIC_FACTOR_DEFAULT=1.15
TRAFFIC_FACTOR_MORNING=1.45
TRAFFIC_FACTOR_EVENING=1.50
TRAFFIC_FACTOR_OVERNIGHT=0.95
TRAFFIC_FACTOR_WEEKEND=1.10

# Section 10.1: do NOT point this at tile.openstreetmap.org in production — their
# tile server is not licensed for it. Left empty a development build falls back to
# OSM so the map works out of the box, and a production build draws the pins with
# no basemap and says so on screen rather than looking broken.
# Passed through to the panel and the website as NEXT_PUBLIC_MAP_TILE_URL by
# docker-compose, and compiled into both Flutter apps by scripts/build_web_apps.sh
# — so this one line is the basemap for every surface, and leaving it empty is
# why a release build of either app draws a graticule and no map.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --------------------------------------------------------------- Dispatch ---
# Safety net for a countdown task lost to a worker restart (seconds between sweeps).
DISPATCH_SWEEP_SECONDS=30

# ------------------------------------------------------------- Stripe -------
# Section 7.2: payment is taken after the work, as a hosted Stripe invoice page
# sent by SMS or email. `mock` needs no keys and makes no network calls, so the
# whole flow — raise, send, webhook, mark paid — runs locally with no spend.
# `test` is the Stripe sandbox; `live` is real money. Never deploy on mock:
# GET /api/v1/health reports the mode and the panel shows it.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen`, or the endpoint's settings in the Stripe dashboard. Test
# and live have different secrets for the same endpoint.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------- Where call-outs land -----
SHOP_NOTIFY_SMS=+447700900999
SHOP_NOTIFY_EMAIL=owner@shiraztyres.co.uk
DEFAULT_FROM_EMAIL=no-reply@shiraztyres.co.uk
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# -------------------------------------------------------- Panel / website ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws
# The customer site's own address, in your browser. The panel's Apps page links
# to the live site at https://shiraztyres.co.uk/ and does not read this.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3001
# Where the Next.js server side reaches the API (inside the compose network).
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Rate limits — leave unset in production to keep the defaults in settings.py
# (otp 5/hour, job create 10/hour). Loosen them only for a demo or a test run.
# THROTTLE_OTP_REQUEST=60/hour
# THROTTLE_OTP_VERIFY=120/hour
# THROTTLE_VEHICLE_LOOKUP=300/hour
# THROTTLE_DRIVER_LOOKUP=600/hour
# THROTTLE_JOB_CREATE=120/hour
